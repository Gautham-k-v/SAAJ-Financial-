# Copy to .env when a local override is needed. The server boots without this file.

NODE_ENV=development
# 5050 avoids the macOS AirPlay receiver, which commonly occupies port 5000.
PORT=5050

# Browser origin allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173

# Used when MongoDB is connected in a later stage. Not read yet.
MONGODB_URI=mongodb://127.0.0.1:27017/saaj

# Used when session authentication is added. Not read yet.
# Generate a long random value. Do not commit a real secret.
SESSION_SECRET=replace-with-a-long-random-string
